\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{listings-extended}[2018/01/23 Custom Package]

\RequirePackage{xcolor}
\RequirePackage{listings}

% define GRust language highlighting
\definecolor{GrayBackground}{RGB}{241,241,241}
\definecolor{BlackText}{RGB}{10,10,10}
\definecolor{RedTypename}{RGB}{182,86,17}
\definecolor{GreenString}{RGB}{150,170,50}
\definecolor{PurpleKeyword}{RGB}{184,84,212}
\definecolor{GrayComment}{RGB}{170,170,170}
\definecolor{GoldDocumentation}{RGB}{180,165,45}
\lstdefinelanguage{GRust}
{
columns=fullflexible,
keepspaces=true,
frame=single,
framesep=0pt,
framerule=0pt,
framexleftmargin=0pt,
framexrightmargin=0pt,
framextopmargin=5pt,
framexbottommargin=0pt,
xleftmargin=0pt,
xrightmargin=0pt,
basicstyle=\ttfamily\footnotesize\color{BlackText},
keywords={
        true,false,
        unsafe,async,await,move,
        use,pub,crate,super,self,mod,
        struct,enum,fn,const,static,let,mut,ref,type,impl,dyn,trait,where,as,component,service,function,init,last,
        break,continue,if,then,else,while,for,loop,match,when,return,yield,in,out,fby,import,export,vars,emit,
        sample,scan,throttle,on_change,persist,time,timeout,reset_on,merge,requires,ensures
    },
keywordstyle=\color{PurpleKeyword},
ndkeywords={
        bool,u8,u16,u32,u64,u128,i8,i16,i32,i64,i128,char,str,int,float,unit,signal,event,
        Self,Option,Some,Result,Ok,Err,String,Box,Vec,Rc,Arc,Cell,RefCell,HashMap,BTreeMap,Alert,Braking,
        macro_rules,InternalState,EstimatorState
    },
ndkeywordstyle=\color{RedTypename},
comment=[l][\color{GrayComment}\slshape]{//},
morecomment=[s][\color{GrayComment}\slshape]{/*}{*/},
morecomment=[l][\color{GoldDocumentation}\slshape]{///},
morecomment=[s][\color{GoldDocumentation}\slshape]{/*!}{*/},
morecomment=[l][\color{GoldDocumentation}\slshape]{//!},
morecomment=[s][\color{RedTypename}]{\#![}{]},
morecomment=[s][\color{RedTypename}]{\#[}{]},
stringstyle=\color{GreenString},
string=[b]",
numbers=left,
firstnumber=auto,
numberstyle=\tiny,
numbersep=7pt,
xleftmargin=10pt,
sensitive=true,
morestring=[b]",
escapechar=\%,
mathescape=true,
showstringspaces=false
}

% define Rust language highlighting
\lstdefinelanguage{Rust}
{
columns=fullflexible,
keepspaces=true,
frame=single,
framesep=0pt,
framerule=0pt,
